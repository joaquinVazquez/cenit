# Dependencias y compilaciones (por si en algún momento agregas herramientas)
node_modules/
dist/
build/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores y entornos locales
.vscode/
.idea/
*.swp
*.swo

# Variables de entorno y secretos (nunca subir claves o tokens)
.env
.env.*
!.env.example

